# ==============================================================================
# KANAKKUFLOW ERP - Environment Variables Template
# Copy this file to .env and configure for your local or cloud environment.
# NEVER commit production credentials or actual secrets to git!
# ==============================================================================

# Application Environment (development | production | staging)
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=KANAKKUFLOW

# Database Connection (External Managed PostgreSQL: Neon, Supabase, AWS RDS, etc.)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Always use SSL (sslmode=require) when connecting to cloud-hosted databases.
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT & Authentication Secret (Generate with: openssl rand -hex 32)
# Backend-only variable - NEVER prefix with VITE_ or expose to client bundles!
JWT_SECRET_KEY=replace_with_a_64_character_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cross-Origin Resource Sharing (CORS)
# Accepts JSON array or comma-separated list of allowed origins.
# In Vercel same-origin multi-service deployment, frontend and backend share the domain.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://*.vercel.app"]

# Frontend Configuration (Exposed to client build via Vite)
# In Vercel multi-service mode, all API calls use the same-origin '/api' path.
VITE_API_BASE_URL=/api
